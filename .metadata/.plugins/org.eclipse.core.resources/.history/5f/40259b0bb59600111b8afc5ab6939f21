@charset "UTF-8";

*{
	margin: 0;
	padding: 0;
	
	/* 너비를 계산할때 패팅값과 너비를 같이 계산한다 */ 
	box-sizing: border-box;
	
	font-size: 16px;
}

body{
	margin: 1rem;
	background-color: black;
	color: white;
}

a{
	color: inherit;
	text-decoration: none;
}

header{
	display: flex;
	justify-content: space-between;
	gap: 1rem;
}

main{
	text-align: center;
}

main h1{
	font-size: 5rem;
}

.max-container{
	width: 1200px;
	margin: 1rem auto;
}


